# Copy to .env (same folder as api.py) and fill in.  NEVER commit or share the real .env.
# The installers (install-mac-host.sh / install-win-host.ps1) create this file for you.
# Plain KEY=value lines only; values with spaces are fine and nothing here is executed.
# A variable already set in the shell/environment wins over the value here.

# -- Typesense (search engine) --------------------------------------------------
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108
# Secret API key. Generate a NEW random one:  openssl rand -hex 24   (the installers do this)
# Never reuse a key that was ever committed, pasted in a chat, or shared.
TYPESENSE_KEY=CHANGE_ME_generate_with_openssl_rand_hex_24
# Optional overrides (auto-detected when blank):
# TYPESENSE_BIN=/opt/homebrew/bin/typesense-server
# TYPESENSE_DATA_DIR=/Users/you/typesense-data
# TYPESENSE_LISTEN_ADDRESS=127.0.0.1
# CLIPSTAGE_PYTHON=/path/to/project/.venv/bin/python

# Search collection. clips_v2 = schema with word-by-word search.
CLIPSTAGE_COLLECTION=clips_v2

# -- Supabase login ------------------------------------------------------------
# Project URL and public anon/publishable key. NEVER put the service-role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# -- Network / security --------------------------------------------------------
CLIPSTAGE_API_PORT=8000
#   0.0.0.0   = every machine on the network can open http://<this-machine-ip>:8000  (DEFAULT here)
#   127.0.0.1 = only this machine. Use this together with the HTTPS proxy (Caddyfile.sample).
# With 0.0.0.0 and no HTTPS proxy, passwords and the login cookie travel unencrypted on the LAN
# (acceptable on a trusted internal network only).
CLIPSTAGE_BIND_HOST=0.0.0.0
# Set to 1 when users reach the app over https (marks the login cookie Secure).
CLIPSTAGE_COOKIE_SECURE=0
# Only when the UI is served from a DIFFERENT origin than the API (comma separated).
# Empty = same-origin only (CORS closed).
CLIPSTAGE_ALLOWED_ORIGINS=
# CLIPSTAGE_DOCS=1               expose /docs (API explorer) - leave off in production

# -- Paths / volumes -----------------------------------------------------------
# macOS: NAS shares mount at /Volumes/<share>.   Windows: C:/Volumes/<share> (folder link to \\NAS\<share>).
CLIPSTAGE_VOLUMES_ROOT=/Volumes
CLIPSTAGE_SCAN_VOLUMES=EDIT,EDIT2,INGEST,PLAYOUT,DIGITAL,SHARE FOLDER,TRANSCODER
# macOS: /Users/Shared/staging      Windows: C:/ClipStage-Staging
CLIPSTAGE_STAGING_PATH=/Users/Shared/staging
# Name of the shared folder editors connect to (smb://HOST/staging  or  \\HOST\staging)
CLIPSTAGE_STAGING_SHARE=staging
# How a staged clip is placed in the editor's folder: symlink | hardlink | copy
CLIPSTAGE_LINK_MODE=symlink
# CLIPSTAGE_THUMB_DIR=./static/thumbs
# CLIPSTAGE_DB=./clipstage.db    SQLite file holding notes, usage, locks, audit (BACK THIS UP)
# Full paths to ffmpeg / ffprobe (the Windows installer fills these in; blank = look on PATH)
# CLIPSTAGE_FFMPEG=
# CLIPSTAGE_FFPROBE=

# -- Performance / limits (defaults shown) -------------------------------------
CLIPSTAGE_SCAN_THREADS=16
CLIPSTAGE_PROBE_THREADS=8
CLIPSTAGE_MAX_RESULTS=2000
# Best-match ranking: match scores are grouped into this many bands; clips in the same band
# are ordered by popularity (times staged), then newest. 0 = exact ties only, higher = favour relevance.
CLIPSTAGE_RANK_BUCKETS=5
CLIPSTAGE_MAX_STREAMS=3
# CLIPSTAGE_NUM_TYPOS=0          1 = tolerate one typo per word

# -- Safety --------------------------------------------------------------------
# Refuse to prune a volume when more than this % of its clips look missing.
CLIPSTAGE_PRUNE_MAX_PERCENT=5
# Nightly job: make new thumbnails after indexing (1/0) and how many per night.
CLIPSTAGE_THUMBS=1
CLIPSTAGE_THUMBS_LIMIT=5000
# CLIPSTAGE_THUMB_WORKERS=4  CLIPSTAGE_THUMB_RETRY_DAYS=7  CLIPSTAGE_THUMB_TIMEOUT=30

# -- Alerts (optional) ---------------------------------------------------------
# Slack/Teams/Discord-style incoming webhook that accepts {"text": "..."}.
# CLIPSTAGE_ALERT_WEBHOOK=https://hooks.example.com/services/XXX

# -- File-share hint shown in the UI -------------------------------------------
# Address of THIS machine as editors see it (used by the "open staging folder" button).
CLIPSTAGE_SMB_HOST=10.1.10.XXX

# -- Proxy trust ---------------------------------------------------------------
# IPs allowed to set X-Forwarded-* headers (the HTTPS proxy on this machine). Default shown.
# CLIPSTAGE_FORWARDED_ALLOW_IPS=127.0.0.1

# -- NAS account (used to mount the NAS shares automatically) --------------------
# A domain/service account for the NAS - separate from the Supabase logins used to sign in to ClipStage.
CLIPSTAGE_NAS_HOST=
CLIPSTAGE_NAS_DOMAIN=
CLIPSTAGE_NAS_USER=
CLIPSTAGE_NAS_PASSWORD=

# -- Backups ---------------------------------------------------------------------
# The nightly job copies clipstage.db here (default ./backups/db). Point it at another disk or a
# NAS share for an off-machine copy.
# CLIPSTAGE_BACKUP_DIR=
# CLIPSTAGE_BACKUP_KEEP=14

# -- Windows only (written by install-win-host.ps1) -------------------------------
# Name of the dedicated WSL2 distro that runs Typesense (Typesense has no native Windows build)
# CLIPSTAGE_WSL_DISTRO=ClipStage
# CLIPSTAGE_EDITOR_SHARE_USER=clipstage-editor
# CLIPSTAGE_EDITOR_SHARE_PASSWORD=       (generated by the installer; read-only login editors use for the share)

# -- Stopping an index from the web page ---------------------------------------------
# The Stop button asks the indexer to stop at its next checkpoint (nothing is deleted). If it has
# not stopped after this many seconds (e.g. stuck on an unreachable NAS) it is ended by force.
# CLIPSTAGE_STOP_GRACE=30

# -- Index checkpoints ------------------------------------------------------------------
# While indexing, finished clips are saved to the index every N clips, so an interrupted long run
# (crash, restart, Stop button) keeps its work. Smaller = safer, slightly slower.
# CLIPSTAGE_CHECKPOINT=2000
